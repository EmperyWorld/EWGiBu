{
  "$id": "iacpack.schemas.cli.v1.status",
  "title": "iacpack status command JSON result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "ok", "result", "diagnostics"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "iacpack.cli/v1" },
    "command": { "type": "string", "const": "status" },
    "ok": { "type": "boolean" },
    "result": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["project", "instance", "providerSlug", "semanticHash", "bundleDigest", "lastRun", "owned"],
          "properties": {
            "project": { "type": "string" },
            "instance": { "type": "string" },
            "providerSlug": { "type": "string" },
            "semanticHash": { "type": "string" },
            "bundleDigest": { "type": "string" },
            "lastRun": { "type": "object" },
            "owned": { "type": "array" },
            "recovery": { "type": "array" }
          }
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "iacpack.schemas.cli.v1.diagnostics" }
    }
  }
}
