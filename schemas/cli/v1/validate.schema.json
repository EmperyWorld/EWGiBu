{
  "$id": "iacpack.schemas.cli.v1.validate",
  "title": "iacpack validate command JSON result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "ok", "result", "diagnostics"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "iacpack.cli/v1"
    },
    "command": {
      "type": "string",
      "const": "validate"
    },
    "ok": {
      "type": "boolean"
    },
    "result": {
      "description": "null on failure; object with file on success",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "iacpack.schemas.cli.v1.diagnostics"
      }
    }
  }
}
