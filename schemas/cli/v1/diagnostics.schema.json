{
  "$id": "iacpack.schemas.cli.v1.diagnostics",
  "title": "iacpack diagnostic object",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "severity", "message", "retryable"],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_.]*$"
    },
    "severity": {
      "type": "string",
      "enum": ["error", "warning", "info"]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "pointer": { "type": "string" },
        "line": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 }
      }
    },
    "hint": {
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    }
  }
}
