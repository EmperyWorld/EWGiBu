{
  "$id": "iacpack.schemas.cli.v1.envelope",
  "title": "iacpack CLI machine-output envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "ok", "result", "diagnostics"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "iacpack.cli/v1"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "result": {
      "description": "Command-specific payload; null on failure when no result is available."
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
