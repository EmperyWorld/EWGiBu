{
  "$id": "iacpack.schemas.cli.v1.inspect_graph",
  "title": "iacpack inspect graph JSON envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "ok", "result", "diagnostics"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "iacpack.cli/v1"
    },
    "command": {
      "type": "string",
      "const": "inspect graph"
    },
    "ok": {
      "type": "boolean"
    },
    "result": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["deploymentHash", "graphHash", "project", "actions", "edges", "order"],
          "properties": {
            "deploymentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "graphHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "project": {
              "type": "object",
              "required": ["name", "version"],
              "properties": {
                "name": { "type": "string" },
                "version": { "type": "string" }
              }
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "kind", "label"],
                "properties": {
                  "id": { "type": "string" },
                  "kind": { "type": "string" },
                  "target": { "type": "string" },
                  "phase": { "type": "string" },
                  "label": { "type": "string" }
                }
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["from", "to"],
                "properties": {
                  "from": { "type": "string" },
                  "to": { "type": "string" },
                  "condition": { "type": "string" }
                }
              }
            },
            "order": {
              "type": "array",
              "items": { "type": "string" }
            },
            "mermaid": { "type": "string" }
          }
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message", "retryable"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warning", "info"] },
          "message": { "type": "string" },
          "hint": { "type": "string" },
          "retryable": { "type": "boolean" },
          "source": { "type": "object" }
        }
      }
    }
  }
}
