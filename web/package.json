{
  "name": "iacpack-web",
  "private": true,
  "license": "MIT",
  "version": "1.1.0",
  "description": "Local authoring UI for iacpack (P12 vertical slice).",
  "type": "module",
  "engines": {
    "node": "^24.21.0 || ^24.5.0",
    "pnpm": "^10.34.6"
  },
  "packageManager": "pnpm@10.34.6",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "typescript": ">=4.8.4"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && node ./node_modules/typescript7/bin/tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "generate:api": "openapi-typescript ../openapi/v1/openapi.yaml -o src/api/generated/schema.d.ts",
    "lint": "eslint src e2e --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && node scripts/check-drift.mjs",
    "check:all": "pnpm check && pnpm build"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
